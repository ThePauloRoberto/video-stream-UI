            "port": 0
          },
          "configurations": {
            "production": {
              "target": "mfe-catalog:esbuild:production"
            },
            "development": {
              "target": "mfe-catalog:esbuild:development",
              "dev": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "mfe-catalog:serve-original:development",
            "rebuildDelay": 0,
            "dev": true,
            "port": 0
          }
        },
        "esbuild": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/mfe-catalog",
            "index": "projects/mfe-catalog/src/index.html",
            "browser": "projects/mfe-catalog/src/main.ts",
            "polyfills": [
              "zone.js",
              "es-module-shims"
            ],
            "tsConfig": "projects/mfe-catalog/tsconfig.app.json",
            "assets": [
              "projects/mfe-catalog/src/assets"
            ],
            "styles": [
              "projects/mfe-catalog/src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve-original": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mfe-catalog:esbuild:production"
            },
            "development": {
              "buildTarget": "mfe-catalog:esbuild:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "port": 4201
          }
        }
      }
    },
    "mfe-player": {
      "projectType": "application",
      "root": "projects/mfe-player",
      "sourceRoot": "projects/mfe-player/src",
      "prefix": "mfe-player",
      "architect": {
        "build": {
          "builder": "@angular-architects/native-federation:build",
          "options": {
            "target": "mfe-player:esbuild:production",
